#!/bin/bash
#SBATCH -A banfield
#SBATCH -p standard
#SBATCH --qos=standard_expand_2
#SBATCH -c 64
#SBATCH -J lf_softrec
#SBATCH --exclude=node-48-256g-2,node-48-256g-3,node-48-256g-8,node-48-256g-9,node-48-256g-12,node-48-256g-13,node-48-256g-14
#SBATCH -o /groups/banfield/projects/environmental/sr/srvp2020/Jacob/ELSA/redesign_20261111/logs/linfree_big_%j.log
# token-free round-2 configuration with a lineage map. usage: MAP=<groups parquet> TAG=<tag> [REFCHECK=1] sbatch --export=ALL run_big.sbatch
set -euo pipefail
RD=/groups/banfield/projects/environmental/sr/srvp2020/Jacob/ELSA/redesign_20261111
PY=$RD/ws_tokens/env/bin/python
T="${SLURM_CPUS_ON_NODE:?}"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=$T OPENBLAS_NUM_THREADS=$T MKL_NUM_THREADS=$T
export NUMBA_NUM_THREADS="$T" NUMBA_THREADING_LAYER=workqueue
export TMPDIR="$RD/tmp" NUMBA_CACHE_DIR="$RD/tmp/numba_lfbig_${SLURM_JOB_ID}"
mkdir -p "$NUMBA_CACHE_DIR"
echo "$(date -Is) host=$(hostname) threads=$T job=$SLURM_JOB_ID map=${MAP:?} tag=${TAG:?}"
EXTRA=()
[[ -n "${REFCHECK:-}" ]] && EXTRA+=(--refcheck)
"$PY" -u "$RD/lineagefree/code/softrec_lf.py" run --lineage-map "$MAP" --tag "$TAG" --threads "$T" "${EXTRA[@]}"
echo "$(date -Is) done"
