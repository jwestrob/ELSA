#!/bin/bash
#SBATCH -A banfield
#SBATCH -p standard
#SBATCH --qos=standard_expand
#SBATCH -c 24
#SBATCH -J bnd
#SBATCH --exclude=node-48-256g-2,node-48-256g-3,node-48-256g-8,node-48-256g-9,node-48-256g-12,node-48-256g-13,node-48-256g-14
#SBATCH -o /groups/banfield/projects/environmental/sr/srvp2020/Jacob/ELSA/redesign_20261111/logs/boundary_%j.log

# Runs one boundary-workstream script with all allocated CPUs.
# usage: SCRIPT=explore.py ARGS="--arm rescue3" sbatch --export=ALL run_py.sbatch
set -euo pipefail
RD=/groups/banfield/projects/environmental/sr/srvp2020/Jacob/ELSA/redesign_20261111
PY=/home/jwestrob/miniconda3/envs/elsa/bin/python
T="${SLURM_CPUS_ON_NODE:?}"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export NUMBA_NUM_THREADS="$T" NUMBA_THREADING_LAYER=workqueue
export TMPDIR="$RD/tmp" NUMBA_CACHE_DIR="$RD/tmp/numba_bnd_${SLURM_JOB_ID}"
mkdir -p "$NUMBA_CACHE_DIR"
echo "host $(hostname) cpus $T script ${SCRIPT:?} args ${ARGS:-}"
"$PY" -u "$RD/boundary/code/${SCRIPT}" --threads "$T" ${ARGS:-}
