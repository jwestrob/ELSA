{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"A0A0B0QJR1","uniProtkbId":"HEPT_APHF2","entryAudit":{"firstPublicDate":"2021-04-07","lastAnnotationUpdateDate":"2026-11-04","lastSequenceUpdateDate":"2021-04-07","entryVersion":37,"sequenceVersion":2},"annotationScore":5.0,"organism":{"scientificName":"Aphanizomenon flos-aquae (strain 2012/KM1/D3)","taxonId":1532906,"lineage":["Bacteria","Bacillati","Cyanobacteriota","Cyanophyceae","Nostocales","Aphanizomenonaceae","Aphanizomenon"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"33290744"}],"value":"tRNA nuclease HepT"},"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"33290744"}],"value":"3.1.27.-"}]},"alternativeNames":[{"fullName":{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"33290744"}],"value":"Toxin HEPN"}},{"fullName":{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"33290744"}],"value":"tRNA nuclease HEPN"}}]},"genes":[{"geneName":{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"33290744"}],"value":"hepT"},"synonyms":[{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"33290744"}],"value":"hepn"}],"orfNames":[{"value":"OA07_26455"}]}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"33290744"}],"value":"Toxic component of a type VII toxin-antitoxin (TA) system. Upon cloning in E.coli inhibits cell growth for several hours; eventually cells recover and start growing. Cleaves the last 4 nucleotides from the tRNA acceptor stem (shown in vitro with E.coli tRNA-Glu(UUC)); only cleaves intact tRNA. Has no activity on mRNA. Neutralized by coexpression with cognate antitoxin MntA, which is due to di-AMPylation of the RNase"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"(tRNA)-3'-end (ribonucleoside